{
  "protocol_version": 1,
  "study_id": "fidelitymcts-frozenlake-l1-v1",
  "stage": "exploratory",
  "hypotheses": [
    "H1: adaptive frontier routing improves the success-cost frontier over learned-only and classical UCT baselines",
    "H2: learned EVC routing uses fewer executable-clone calls than a fixed cascade at matched success"
  ],
  "primary_endpoints": [
    "episode_success_rate",
    "normalized_cost",
    "accurate_calls"
  ],
  "secondary_endpoints": [
    "episode_return",
    "environment_calls",
    "model_calls",
    "latency_s",
    "verified_pairs"
  ],
  "benchmark": {
    "type": "gymnasium_frozenlake",
    "env_id": "FrozenLake-v1",
    "map_name": "4x4",
    "is_slippery": false,
    "maximum_episode_steps": 20,
    "clone_step_cost": 0.25,
    "version": "Gymnasium FrozenLake-v1 / 4x4 deterministic"
  },
  "training": {
    "algorithm": "tabular_q_learning",
    "episodes": 2500,
    "seed": 1801,
    "router_training_seed": 2801,
    "router_calibration_states": [2, 7, 10, 14],
    "alpha": 0.2,
    "discount": 0.99,
    "epsilon_start": 1.0,
    "epsilon_end": 0.05,
    "maximum_steps": 20,
    "inference_cost": 0.05,
    "router_ridge": 1.0,
    "discrepancy_ridge": 1.0,
    "calibration_coverage": 0.9,
    "split_policy": "offline training and router calibration precede all evaluation seeds"
  },
  "methods": [
    "direct_learned",
    "classical_uct",
    "frontier_learned",
    "frontier_accurate",
    "frontier_fixed",
    "frontier_random",
    "frontier_threshold",
    "frontier_evc"
  ],
  "ablations": [
    "frontier_evc_without_contextual_discrepancy",
    "frontier_evc_without_audit_traffic",
    "frontier_evc_with_fixed_stopping",
    "frontier_routing_without_verified_replay"
  ],
  "method_settings": {
    "classical_uct": {"tree_depth": 16},
    "frontier_learned": {"tree_depth": 16},
    "frontier_fixed": {"tree_depth": 16, "top_k": 2},
    "frontier_random": {
      "tree_depth": 16,
      "escalation_probability": 0.25
    },
    "frontier_threshold": {"tree_depth": 16, "z_score": 1.64},
    "frontier_evc": {
      "tree_depth": 16,
      "accurate_cost": 5.0,
      "cost_weight": 0.02,
      "minimum_net_evc": 0.0,
      "audit_probability": 0.1,
      "fixed_query_limit": 4
    }
  },
  "budget_grid": [
    {
      "max_cost": 24.0,
      "max_tokens": 0,
      "max_accurate_calls": 2,
      "max_iterations": 12,
      "max_model_calls": 80,
      "max_environment_calls": 60
    },
    {
      "max_cost": 48.0,
      "max_tokens": 0,
      "max_accurate_calls": 4,
      "max_iterations": 24,
      "max_model_calls": 160,
      "max_environment_calls": 120
    }
  ],
  "resource_accounting": {
    "normalized_cost_definition": "native environment step = 1.0; executable clone step = 0.25; learned table inference = 0.05",
    "frontier_budget": {
      "max_cost": 6.0,
      "max_tokens": 0,
      "max_accurate_calls": 1,
      "max_iterations": 5,
      "max_model_calls": 5,
      "max_environment_calls": 20
    }
  },
  "pilot_seeds": [701, 702, 703, 704, 705, 706, 707, 708, 709, 710],
  "confirmatory_seeds": [
    1701, 1702, 1703, 1704, 1705, 1706, 1707, 1708, 1709, 1710,
    1711, 1712, 1713, 1714, 1715, 1716, 1717, 1718, 1719, 1720,
    1721, 1722, 1723, 1724, 1725, 1726, 1727, 1728, 1729, 1730
  ],
  "analysis": {
    "confidence_level": 0.95,
    "interval_method": "paired_stratified_bootstrap_over_episode_seeds",
    "bootstrap_samples": 10000,
    "multiple_comparison_correction": "Holm within each confirmatory hypothesis family",
    "stopping_rule": "run_all_declared_units",
    "primary_summary": "success-cost-accurate-call Pareto frontier and hypervolume",
    "noninferiority_margin": 0.03
  },
  "failure_policy": {
    "abort_on_error": true,
    "exclude_after_run": false,
    "report_all_failures": true,
    "retry_policy": "no automatic retries"
  },
  "exclusions": [
    "episodes are excluded only for a preregistered infrastructure failure affecting every method for the paired seed",
    "no result-dependent seed, method, or endpoint exclusions"
  ],
  "artifacts": {}
}
