{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montecarlgym.org/schemas/experiment-v1.json",
  "title": "MonteCarloGym experiment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "run",
    "budget",
    "methods"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark": {
      "type": "object"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetitions",
        "base_seed"
      ],
      "properties": {
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "base_seed": {
          "type": "integer"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cost",
        "max_tokens",
        "max_accurate_calls"
      ],
      "properties": {
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_accurate_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "deadline_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "planner_settings": {
      "type": "object"
    }
  }
}
